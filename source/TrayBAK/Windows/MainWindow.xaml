<Window x:Class="TrayBAK.Windows.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="TrayBAK" Width="1000" Height="640" MinWidth="760" MinHeight="420"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <Style x:Key="LevelText" TargetType="TextBlock">
            <Setter Property="Margin" Value="4,0" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Level}" Value="Success">
                    <Setter Property="Foreground" Value="{StaticResource SuccessBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Level}" Value="Warning">
                    <Setter Property="Foreground" Value="{StaticResource WarnBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Level}" Value="Error">
                    <Setter Property="Foreground" Value="{StaticResource ErrorBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="CellText" TargetType="TextBlock">
            <Setter Property="Margin" Value="4,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
    </Window.Resources>
    <Window.InputBindings>
        <KeyBinding Key="F1" Command="{x:Static ApplicationCommands.Help}" />
    </Window.InputBindings>
    <Window.CommandBindings>
        <CommandBinding Command="{x:Static ApplicationCommands.Help}" Executed="HelpCommand_Executed" />
    </Window.CommandBindings>
    <DockPanel>
        <Menu DockPanel.Dock="Top">
            <MenuItem Header="_File">
                <MenuItem Header="_Add job..." Click="Add_Click" />
                <MenuItem Header="Run _all jobs now" Click="RunAll_Click" />
                <Separator />
                <MenuItem Header="E_xit" Click="Exit_Click" />
            </MenuItem>
            <MenuItem Header="_View">
                <MenuItem Header="_Log viewer" Click="Log_Click" />
                <MenuItem Header="Open _logs folder" Click="LogsFolder_Click" />
            </MenuItem>
            <MenuItem Header="_Tools">
                <MenuItem x:Name="PauseMenu" Header="_Pause scheduling" IsCheckable="True" Click="Pause_Click" />
                <Separator />
                <MenuItem Header="_Options..." Click="Options_Click" />
            </MenuItem>
            <MenuItem Header="_Help">
                <MenuItem Header="TrayBAK _Help" InputGestureText="F1" Click="Help_Click" />
                <MenuItem Header="_About TrayBAK" Click="About_Click" />
            </MenuItem>
        </Menu>
        <StatusBar DockPanel.Dock="Bottom">
            <TextBlock x:Name="StatusText" />
        </StatusBar>
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="12,12,12,8">
            <Button Content="Add job" Width="90" Click="Add_Click" />
            <Button x:Name="EditButton" Content="Edit" Width="90" Margin="8,0,0,0" Click="Edit_Click" />
            <Button x:Name="DeleteButton" Content="Delete" Width="90" Margin="8,0,0,0" Click="Delete_Click" />
            <Button x:Name="RunButton" Content="Run now" Width="90" Margin="24,0,0,0" Click="Run_Click" />
            <Button x:Name="StopButton" Content="Stop" Width="90" Margin="8,0,0,0" Click="Stop_Click" />
            <Button x:Name="FolderButton" Content="Open backups" Width="110" Margin="8,0,0,0" Click="OpenFolder_Click" />
        </StackPanel>
        <Grid Margin="12,0,12,12">
            <Grid.RowDefinitions>
                <RowDefinition Height="2*" MinHeight="120" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" MinHeight="80" />
            </Grid.RowDefinitions>
            <DataGrid x:Name="JobGrid" AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single"
                      HeadersVisibility="Column" GridLinesVisibility="Horizontal" CanUserAddRows="False"
                      SelectionChanged="JobGrid_SelectionChanged" MouseDoubleClick="JobGrid_DoubleClick">
                <DataGrid.Columns>
                    <DataGridTemplateColumn Header="On" Width="44">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <CheckBox IsChecked="{Binding Enabled, UpdateSourceTrigger=PropertyChanged}"
                                          HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="Job" Binding="{Binding Name}" Width="150" ElementStyle="{StaticResource CellText}" />
                    <DataGridTextColumn Header="Schedule" Binding="{Binding ScheduleText}" Width="150" ElementStyle="{StaticResource CellText}" />
                    <DataGridTextColumn Header="Status" Binding="{Binding StatusText}" Width="80" ElementStyle="{StaticResource CellText}" />
                    <DataGridTextColumn Header="Last run" Binding="{Binding LastRunText}" Width="130" ElementStyle="{StaticResource CellText}" />
                    <DataGridTemplateColumn Header="Result" Width="90">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding ResultText}" Foreground="{Binding ResultBrush}"
                                           Margin="4,0" VerticalAlignment="Center" FontWeight="SemiBold" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="Size" Binding="{Binding SizeText}" Width="80" ElementStyle="{StaticResource CellText}" />
                    <DataGridTextColumn Header="Next run" Binding="{Binding NextRunText}" Width="130" ElementStyle="{StaticResource CellText}" />
                    <DataGridTextColumn Header="Details" Binding="{Binding Details}" Width="*" ElementStyle="{StaticResource CellText}" />
                </DataGrid.Columns>
            </DataGrid>
            <GridSplitter Grid.Row="1" Height="6" HorizontalAlignment="Stretch" ResizeDirection="Rows" />
            <DataGrid x:Name="LogGrid" Grid.Row="2" AutoGenerateColumns="False" IsReadOnly="True"
                      HeadersVisibility="Column" GridLinesVisibility="None" CanUserAddRows="False">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Time" Binding="{Binding TimeText}" Width="150" ElementStyle="{StaticResource LevelText}" />
                    <DataGridTextColumn Header="Level" Binding="{Binding Level}" Width="80" ElementStyle="{StaticResource LevelText}" />
                    <DataGridTextColumn Header="Job" Binding="{Binding Job}" Width="140" ElementStyle="{StaticResource LevelText}" />
                    <DataGridTextColumn Header="Message" Binding="{Binding Message}" Width="*" ElementStyle="{StaticResource LevelText}" />
                </DataGrid.Columns>
            </DataGrid>
        </Grid>
    </DockPanel>
</Window>
