<Window x:Class="TrayBAK.Windows.FolderPickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Choose what to back up" Width="560" Height="640" MinWidth="420" MinHeight="400"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <Window.Resources>
        <Style x:Key="NodeCheck" TargetType="CheckBox">
            <Setter Property="IsThreeState" Value="True" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsPlaceholder}" Value="True">
                    <Setter Property="Visibility" Value="Collapsed" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="NodeText" TargetType="TextBlock">
            <Setter Property="Margin" Value="6,0,0,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsDirectory}" Value="True">
                    <Setter Property="FontWeight" Value="SemiBold" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsPlaceholder}" Value="True">
                    <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>
    <DockPanel>
        <StackPanel DockPanel.Dock="Bottom" Margin="16,8,16,16">
            <DockPanel>
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                    <Button Content="Select all" Click="SelectAll_Click" Padding="12,4" />
                    <Button Content="Clear all" Click="ClearAll_Click" Padding="12,4" Margin="8,0,0,0" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="OK" IsDefault="True" Width="90" Click="Ok_Click" />
                    <Button Content="Cancel" IsCancel="True" Width="90" Margin="8,0,0,0" />
                </StackPanel>
            </DockPanel>
        </StackPanel>
        <StackPanel DockPanel.Dock="Top" Margin="16,16,16,8">
            <TextBlock x:Name="SourceText" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
            <TextBlock Margin="0,6,0,0" TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}"
                       Text="Untick anything you do not want backed up. A ticked folder includes everything inside it, including files added later. Unticked items are skipped." />
        </StackPanel>
        <TreeView x:Name="Tree" Margin="16,0,16,0" TreeViewItem.Expanded="Tree_Expanded"
                  VirtualizingStackPanel.IsVirtualizing="True" VirtualizingStackPanel.VirtualizationMode="Recycling">
            <TreeView.ItemTemplate>
                <HierarchicalDataTemplate ItemsSource="{Binding Children}">
                    <StackPanel Orientation="Horizontal">
                        <CheckBox Style="{StaticResource NodeCheck}" IsChecked="{Binding IsChecked, Mode=TwoWay}" />
                        <TextBlock Style="{StaticResource NodeText}" Text="{Binding Name}" />
                    </StackPanel>
                </HierarchicalDataTemplate>
            </TreeView.ItemTemplate>
        </TreeView>
    </DockPanel>
</Window>
