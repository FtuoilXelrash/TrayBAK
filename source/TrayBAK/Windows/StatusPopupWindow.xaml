<Window x:Class="TrayBAK.Windows.StatusPopupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None" ResizeMode="NoResize" ShowInTaskbar="False" Topmost="True"
        SizeToContent="Height" Width="400" MaxHeight="620"
        Deactivated="Window_Deactivated" Loaded="Window_Loaded">
    <Border BorderThickness="1" BorderBrush="{StaticResource MutedBrush}" Padding="14">
        <DockPanel>
            <Grid DockPanel.Dock="Top">
                <TextBlock x:Name="HeaderText" FontSize="16" FontWeight="SemiBold" />
                <TextBlock x:Name="StateText" HorizontalAlignment="Right" VerticalAlignment="Center"
                           Foreground="{StaticResource MutedBrush}" />
            </Grid>
            <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,12,0,0">
                <Button Content="Open TrayBAK" Click="Open_Click" Padding="12,4" />
                <Button x:Name="PauseButton" Margin="8,0,0,0" Padding="12,4" Click="Pause_Click" />
            </StackPanel>
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <ItemsControl x:Name="Items">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,10,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <Ellipse Width="10" Height="10" Fill="{Binding ResultBrush}" VerticalAlignment="Center" />
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" Margin="8,0,0,0" />
                                        <TextBlock Text="{Binding StatusText}" Foreground="{StaticResource MutedBrush}" Margin="8,0,0,0" />
                                    </StackPanel>
                                    <TextBlock Text="{Binding LastLine}" Margin="18,2,0,0" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" />
                                    <TextBlock Text="{Binding NextLine}" Margin="18,0,0,0" Foreground="{StaticResource MutedBrush}" />
                                </StackPanel>
                                <Button Grid.Column="1" Content="Run" Tag="{Binding}" Click="Run_Click"
                                        VerticalAlignment="Center" Padding="12,3" />
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </DockPanel>
    </Border>
</Window>
