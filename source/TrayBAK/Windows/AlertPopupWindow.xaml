<Window x:Class="TrayBAK.Windows.AlertPopupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None" ResizeMode="NoResize" ShowInTaskbar="False" Topmost="True" ShowActivated="False"
        SizeToContent="Height" Width="360" Loaded="Window_Loaded" Closed="Window_Closed"
        MouseLeftButtonUp="Window_Click">
    <Border BorderThickness="1" BorderBrush="{StaticResource MutedBrush}">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="6" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Border x:Name="Bar" />
            <StackPanel Grid.Column="1" Margin="12,10,12,12">
                <TextBlock x:Name="TitleText" FontWeight="SemiBold" FontSize="14" TextWrapping="Wrap" />
                <TextBlock x:Name="MessageText" Margin="0,4,0,0" TextWrapping="Wrap"
                           Foreground="{StaticResource MutedBrush}" />
            </StackPanel>
        </Grid>
    </Border>
</Window>
