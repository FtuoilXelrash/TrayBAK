<Window x:Class="TrayBAK.Windows.LogViewerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="TrayBAK Log" Width="920" Height="560" MinWidth="640" MinHeight="320"
        WindowStartupLocation="CenterOwner">
    <Window.Resources>
        <Style x:Key="LevelText" TargetType="TextBlock">
            <Setter Property="Margin" Value="4,0" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Level}" Value="Success">
                    <Setter Property="Foreground" Value="{StaticResource SuccessBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Level}" Value="Warning">
                    <Setter Property="Foreground" Value="{StaticResource WarnBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Level}" Value="Error">
                    <Setter Property="Foreground" Value="{StaticResource ErrorBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>
    <DockPanel>
        <StatusBar DockPanel.Dock="Bottom">
            <TextBlock x:Name="CountText" />
        </StatusBar>
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="12">
            <TextBlock Text="Level" VerticalAlignment="Center" />
            <ComboBox x:Name="LevelBox" Width="110" Margin="8,0,16,0" SelectionChanged="Filter_Changed">
                <ComboBoxItem Content="All" IsSelected="True" />
                <ComboBoxItem Content="Info" />
                <ComboBoxItem Content="Success" />
                <ComboBoxItem Content="Warning" />
                <ComboBoxItem Content="Error" />
            </ComboBox>
            <TextBlock Text="Job" VerticalAlignment="Center" />
            <ComboBox x:Name="JobBox" Width="160" Margin="8,0,16,0" SelectionChanged="Filter_Changed" />
            <TextBlock Text="Search" VerticalAlignment="Center" />
            <TextBox x:Name="SearchBox" Width="180" Margin="8,0,16,0" TextChanged="Search_Changed" />
            <Button Content="Open log file" Click="OpenFile_Click" Padding="12,4" />
            <Button Content="Clear log" Click="Clear_Click" Padding="12,4" Margin="8,0,0,0" />
        </StackPanel>
        <DataGrid x:Name="LogGrid" Margin="12,0,12,12" AutoGenerateColumns="False" IsReadOnly="True"
                  HeadersVisibility="Column" GridLinesVisibility="None" CanUserAddRows="False">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Time" Binding="{Binding TimeText}" Width="150" ElementStyle="{StaticResource LevelText}" />
                <DataGridTextColumn Header="Level" Binding="{Binding Level}" Width="80" ElementStyle="{StaticResource LevelText}" />
                <DataGridTextColumn Header="Job" Binding="{Binding Job}" Width="150" ElementStyle="{StaticResource LevelText}" />
                <DataGridTextColumn Header="Message" Binding="{Binding Message}" Width="*" ElementStyle="{StaticResource LevelText}" />
            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>
</Window>
