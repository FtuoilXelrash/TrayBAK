<Window x:Class="TrayBAK.Windows.AboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="About TrayBAK" Width="440" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <StackPanel Margin="24">
        <Image Source="pack://application:,,,/resource/TrayBAK.png" Width="96" Height="96" HorizontalAlignment="Center" />
        <TextBlock Text="TrayBAK" FontSize="26" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,12,0,0" />
        <TextBlock x:Name="VersionText" HorizontalAlignment="Center" Foreground="{StaticResource MutedBrush}" />
        <TextBlock TextWrapping="Wrap" TextAlignment="Center" Margin="0,16,0,0"
                   Text="Scheduled folder backups from the system tray. Zip backups, per-job schedules and retention, local alerts and a full action log." />
        <TextBlock x:Name="CopyrightText" HorizontalAlignment="Center" Margin="0,16,0,0" Foreground="{StaticResource MutedBrush}" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,20,0,0">
            <Button Content="Open Help" Click="Help_Click" Padding="14,5" />
            <Button Content="Close" IsCancel="True" IsDefault="True" Margin="8,0,0,0" Padding="14,5" />
        </StackPanel>
    </StackPanel>
</Window>
